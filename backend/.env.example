PORT=5000
CLIENT_URL=http://localhost:5173

# Cấu hình Aiven Cloud MySQL
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=20441
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_password_here
MYSQL_URI=mysql://avnadmin:your_password_here@your-mysql-host.aivencloud.com:20441/defaultdb?ssl-mode=REQUIRED

# Bảo mật JWT
JWT_SECRET=your_jwt_secret_key_here

# Blockchain Sepolia
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY