                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/pending-events?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "pending-events"],
