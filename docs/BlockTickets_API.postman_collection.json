        {
          "name": "2. Admin Approve Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Verify approval response\", function () {",
                  "    pm.expect([200, 403]).to.include(pm.response.code);",
