      "item": [
        {
          "name": "Register Organizer Account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomSuffix = Math.floor(Math.random() * 10000);",
                  "pm.environment.set(\"orgEmail\", \"organizer_\" + randomSuffix + \"@blocktickets.io\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"User registered with role organizer\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.user.role).to.eql(\"organizer\");",
                  "    pm.environment.set(\"organizerToken\", json.data.accessToken);",
                  "    pm.environment.set(\"organizerRefreshToken\", json.data.refreshToken);",
